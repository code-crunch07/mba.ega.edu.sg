# --------------------------------------------------------------------------
# Brevo (Sendinblue) Transactional Email Configuration
# --------------------------------------------------------------------------
# Get your API key from Brevo Dashboard -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Verified sender email in Brevo (e.g., admissions@ega.edu.sg or info@ega.edu.sg)
BREVO_SENDER_EMAIL=admissions@ega.edu.sg
BREVO_SENDER_NAME="Educare Global Academy"

# Destination email(s) to receive lead notifications (comma-separated for multiple)
BREVO_TO_EMAIL=admissions@ega.edu.sg

# --------------------------------------------------------------------------
# Optional: Webhook (Zapier / Make / HubSpot / Zoho)
# --------------------------------------------------------------------------
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/000000/abcdef
